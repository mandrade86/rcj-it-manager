# Variables del servidor de base de datos de DESARROLLO (Mongo)
# Copia a .env.mongo.dev en el servidor de BD de desarrollo:
#   cp .env.mongo.dev.example .env.mongo.dev

MONGO_BIND=0.0.0.0
MONGO_PORT=27017

# Auth opcional (recomendado). Descomenta ambas líneas.
# La app de desarrollo usará:
# MONGODB_URI=mongodb://rcjdev:CLAVE@IP_BD_DEV:27017/rcj_it_manager_dev?authSource=admin
# MONGO_INITDB_ROOT_USERNAME=rcjdev
# MONGO_INITDB_ROOT_PASSWORD=cambia-esta-clave-dev
