# Variables del servidor de base de datos (Mongo)
# Copia a .env.mongo en el servidor de BD:
#   cp .env.mongo.example .env.mongo

# IP/interfaz donde escucha Mongo. 0.0.0.0 = toda la red (restringe con firewall)
MONGO_BIND=0.0.0.0
MONGO_PORT=27017

# Auth (recomendado). Descomenta ambas líneas y usa la misma clave en MONGODB_URI de la app.
# MONGODB_URI=mongodb://rcjadmin:CLAVE@IP_BD:27017/rcj_it_manager?authSource=admin
# MONGO_INITDB_ROOT_USERNAME=rcjadmin
# MONGO_INITDB_ROOT_PASSWORD=cambia-esta-clave-larga
