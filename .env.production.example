# Copia a .env.production en el servidor Ubuntu
# docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

APP_PORT=3001
# 127.0.0.1 = solo Apache en el mismo servidor (recomendado). 0.0.0.0 = http://IP:3001 en la LAN
APP_BIND=127.0.0.1
APP_PUBLIC_URL=https://portal.rcjcorp.hn

JWT_SECRET=genera-un-secreto-largo-y-aleatorio-distinto-al-de-dev
INIT_DATA_ON_START=false

AUTH_AD_ENABLED=true
# true = AD primero; si falla o la cuenta tiene contraseña local, permite login local
AUTH_LOCAL_FALLBACK=true
EHR_LOGIN_URL=https://ehr.rcjcorp.hn:8095/api/Login
AD_EMAIL_DOMAINS=rcjcorp.com,grupoc.com

ANTHROPIC_API_KEY=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=IT
JIRA_ISSUE_TYPE=Task
