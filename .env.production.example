# Copia a .env.production en el servidor Ubuntu
# docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

APP_PORT=3001
# 127.0.0.1 = solo Apache en el mismo servidor (recomendado). 0.0.0.0 = http://IP:3001 en la LAN
APP_BIND=127.0.0.1
# URL que ven los usuarios (debe ser https tras configurar Apache + certbot)
APP_PUBLIC_URL=https://portal.rcjcorporacion.com
# APP_PUBLIC_URL=https://portal.rcjcorp.hn

JWT_SECRET=genera-un-secreto-largo-y-aleatorio-distinto-al-de-dev
INIT_DATA_ON_START=false

# Login IT Manager (correo + contraseña). AD solo si AUTH_AD_ENABLED=true
AUTH_AD_ENABLED=false
AUTH_LOCAL_FALLBACK=false
AD_DOMAIN=RCJ
AD_EMAIL_DOMAINS=rcjcorp.com,grupoc.com
EHR_LOGIN_URL=https://ehrapi.rcjcorp.hn/api/Login
# Opcional: cuenta de servicio para sync EHR (también configurable en Maestros → Empleados)
# EHR_USERNAME=
# EHR_PASSWORD=

ANTHROPIC_API_KEY=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=IT
JIRA_ISSUE_TYPE=Task

# ── BI Costeo muestras (SAP HANA) — RCJ ───────────────────────────────────────
# Puerto 30015 = SAP HANA. La app en Docker debe alcanzar 172.16.146.16:30015
SAP_BI_DRIVER=hana
SAP_BI_HOST=172.16.146.16
SAP_BI_PORT=30015
# Esquema de la compañía SAP B1 en HANA (ej. nombre tenant BD — confirmar con ERP)
SAP_BI_SCHEMA=RCJ_BI
SAP_BI_DATABASE=RCJ_BI
SAP_BI_VIEW=VW_BI_VENTA_COSTO
SAP_BI_USERNAME=B2User
SAP_BI_PASSWORD=
