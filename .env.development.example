# Copia a .env.development (servidor dev o pruebas Docker)
# docker compose -f docker-compose.dev.yml --env-file .env.development up -d --build

# Node/NSSM lee PORT; Docker compose usa APP_PORT
PORT=3002
APP_PORT=3002
# Todo-en-uno (docker-compose.dev.yml): puerto del Mongo publicado en el host
MONGO_HOST_PORT=27018
# 0.0.0.0 = accesible en la LAN; 127.0.0.1 = solo Apache en el mismo servidor
APP_BIND=0.0.0.0
HOST=127.0.0.1
APP_PUBLIC_URL=http://portal-dev.rcjcorp.hn

JWT_SECRET=dev-secret-cambiar-en-servidor
INIT_DATA_ON_START=false

# PMO Personal (opcional en dev) — deploy/PMO-TEAMS.md / PMO-BOT-HOSTNAME.md
# Messaging endpoint Azure (dev): https://dev-bot.rcjcorp.hn/api/pmo/messages
# TEAMS_WEBHOOK_URL=
# PMO_BOT_APP_ID=
# PMO_BOT_APP_PASSWORD=
# PMO_BOT_TENANT_ID=
# PMO_BOT_APP_TYPE=SingleTenant
# PMO_DIGEST_KEY=

# ── MongoDB (servidor BD desarrollo: RCJ-lnx-sql01) ───────────────────────────
# App Windows Dev (P:\rcj-it-manager) → Mongo en RCJ-lnx-sql01:27017
MONGODB_URI=mongodb://RCJ-lnx-sql01:27017/rcj_it_manager_dev
# Con auth (descomenta y ajusta; comenta la línea de arriba):
# MONGODB_URI=mongodb://rcjdev:CLAVE@RCJ-lnx-sql01:27017/rcj_it_manager_dev?authSource=admin


AUTH_AD_ENABLED=false
AUTH_LOCAL_FALLBACK=false
AD_DOMAIN=RCJ
AD_EMAIL_DOMAINS=rcjcorp.com,grupoc.com
EHR_LOGIN_URL=https://ehrapi.rcjcorp.hn/api/Login

# IA — gemini gratis: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Gastos IT — vista en esquema TS_ZOLIHN (no RCJ_BI)
SAP_COSTOS_IT_VIEW=VW_COSTOS_IT
SAP_COSTOS_IT_SCHEMA=TS_ZOLIHN

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=IT
JIRA_ISSUE_TYPE=Task
