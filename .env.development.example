# Copia a .env.development (servidor dev o pruebas Docker)
# docker compose -f docker-compose.dev.yml --env-file .env.development up -d --build

APP_PORT=3002
MONGO_HOST_PORT=27018
APP_PUBLIC_URL=http://portal-dev.rcjcorporacion.com

JWT_SECRET=dev-secret-cambiar-en-servidor
INIT_DATA_ON_START=false

AUTH_AD_ENABLED=false
AUTH_LOCAL_FALLBACK=false
AD_DOMAIN=RCJ
AD_EMAIL_DOMAINS=rcjcorp.com,grupoc.com
