# Copia a .env.development (servidor dev o pruebas Docker)
# docker compose -f docker-compose.dev.yml --env-file .env.development up -d --build

APP_PORT=3002
# Todo-en-uno (docker-compose.dev.yml): puerto del Mongo publicado en el host
MONGO_HOST_PORT=27018
# 0.0.0.0 = accesible en la LAN; 127.0.0.1 = solo Apache en el mismo servidor
APP_BIND=0.0.0.0
APP_PUBLIC_URL=http://portal-dev.rcjcorporacion.com

JWT_SECRET=dev-secret-cambiar-en-servidor
INIT_DATA_ON_START=false

# ── MongoDB (solo si usas docker-compose.dev-app.yml / --dev --app) ───────────
# Todo-en-uno: no hace falta; la app usa el contenedor "mongo" y la base rcj_it_manager_dev.
# App y BD en servidores distintos:
#   MONGODB_URI=mongodb://IP_BD_DEV:27017/rcj_it_manager_dev
# Con auth:
#   MONGODB_URI=mongodb://rcjdev:CLAVE@IP_BD_DEV:27017/rcj_it_manager_dev?authSource=admin
# MONGODB_URI=mongodb://172.16.x.x:27017/rcj_it_manager_dev


AUTH_AD_ENABLED=false
AUTH_LOCAL_FALLBACK=false
AD_DOMAIN=RCJ
AD_EMAIL_DOMAINS=rcjcorp.com,grupoc.com
EHR_LOGIN_URL=https://ehrapi.rcjcorp.hn/api/Login

# IA — gemini gratis: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Gastos IT — vista en esquema TS_ZOLIHN (no RCJ_BI)
SAP_COSTOS_IT_VIEW=VW_COSTOS_IT
SAP_COSTOS_IT_SCHEMA=TS_ZOLIHN

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=IT
JIRA_ISSUE_TYPE=Task
