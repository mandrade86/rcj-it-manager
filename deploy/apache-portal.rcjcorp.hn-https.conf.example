# Referencia — VirtualHost HTTPS tras certificado (Let's Encrypt o CA interna).
# No copies este archivo tal cual hasta que existan los .pem en las rutas indicadas.
# Lo habitual es usar solo apache-portal.rcjcorp.hn.conf.example + certbot --apache.

<VirtualHost *:80>
    ServerName portal.rcjcorp.hn
    RewriteEngine On
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</VirtualHost>

<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName portal.rcjcorp.hn

    SSLEngine on
    SSLCertificateFile      /etc/letsencrypt/live/portal.rcjcorp.hn/fullchain.pem
    SSLCertificateKeyFile   /etc/letsencrypt/live/portal.rcjcorp.hn/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    ProxyPreserveHost On
    ProxyRequests Off
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"

    ProxyPass / http://127.0.0.1:3001/
    ProxyPassReverse / http://127.0.0.1:3001/

    ErrorLog ${APACHE_LOG_DIR}/portal.rcjcorp.hn-ssl-error.log
    CustomLog ${APACHE_LOG_DIR}/portal.rcjcorp.hn-ssl-access.log combined
</VirtualHost>
</IfModule>
