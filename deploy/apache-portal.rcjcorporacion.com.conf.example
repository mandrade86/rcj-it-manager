# Apache — portal.rcjcorporacion.com → RCJ IT Manager (Docker prod en 127.0.0.1:3001)
#
# Paso 1 — solo HTTP (instalar sitio y obtener certificado):
#   sudo a2enmod proxy proxy_http headers rewrite ssl
#   sudo cp deploy/apache-portal.rcjcorporacion.com.conf.example \
#     /etc/apache2/sites-available/portal.rcjcorporacion.com.conf
#   sudo a2ensite portal.rcjcorporacion.com.conf
#   sudo apachectl configtest && sudo systemctl reload apache2
#
# Paso 2 — HTTPS (Let's Encrypt; ver deploy/HTTPS-APACHE.md):
#   sudo apt install -y certbot python3-certbot-apache
#   sudo certbot --apache -d portal.rcjcorporacion.com
#
# Certbot añade el VirtualHost :443 y redirección HTTP→HTTPS.
# Luego en .env.production: APP_PUBLIC_URL=https://portal.rcjcorporacion.com

<VirtualHost *:80>
    ServerName portal.rcjcorporacion.com

    ProxyPreserveHost On
    ProxyRequests Off
    RequestHeader set X-Forwarded-Proto "http"

    ProxyPass / http://127.0.0.1:3001/
    ProxyPassReverse / http://127.0.0.1:3001/

    ErrorLog ${APACHE_LOG_DIR}/portal.rcjcorporacion.com-error.log
    CustomLog ${APACHE_LOG_DIR}/portal.rcjcorporacion.com-access.log combined
</VirtualHost>
