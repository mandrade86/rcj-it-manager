# Ejemplo: Nginx como proxy inverso en Ubuntu Server
# 1. sudo apt install nginx
# 2. sudo cp deploy/nginx-it-manager.conf.example /etc/nginx/sites-available/it-manager
# 3. Edita server_name y rutas
# 4. sudo ln -s /etc/nginx/sites-available/it-manager /etc/nginx/sites-enabled/
# 5. sudo nginx -t && sudo systemctl reload nginx
# 6. HTTPS: sudo apt install certbot python3-certbot-nginx && sudo certbot --nginx -d it.tu-dominio.local

server {
    listen 80;
    server_name it-manager.rcj.local;  # cambiar

    client_max_body_size 12M;  # subida de certificados / adjuntos

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
