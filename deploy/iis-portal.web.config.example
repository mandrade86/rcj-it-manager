<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reverse proxy IIS → Node. Reinyecta Authorization (ARR lo quita al backend HTTP).

  Una vez (Admin):
    .\fix-iis-pmo-auth.ps1 -SiteName "rcj-it-manager" -PhysicalPath "D:\rcj-it-manager"
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1) Guarda Authorization en variable propia antes del proxy -->
        <rule name="PmoCaptureAuthorization" stopProcessing="false">
          <match url=".*" />
          <conditions>
            <add input="{HTTP_AUTHORIZATION}" pattern=".+" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_AUTHORIZATION" value="{HTTP_AUTHORIZATION}" replace="true" />
          </serverVariables>
          <action type="None" />
        </rule>
        <!-- 2) Proxy a Node + reinyecta Authorization -->
        <rule name="ReverseProxyInboundRule1" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3001/{R:1}" />
          <serverVariables>
            <set name="HTTP_AUTHORIZATION" value="{HTTP_AUTHORIZATION}" replace="true" />
            <set name="HTTP_X_AUTHORIZATION" value="{HTTP_X_AUTHORIZATION}" replace="true" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
