# Copia a `.env` antes de: docker compose up -d --build

# Obligatorio en producción (login JWT)
JWT_SECRET=genera-un-secreto-largo-y-aleatorio

AUTH_AD_ENABLED=true
EHR_LOGIN_URL=https://ehr.rcjcorp.hn:8095/api/Login
AD_EMAIL_DOMAINS=rcjcorp.com,grupoc.com

# Puerto publicado en el host (docker-compose mapea APP_PORT → 3001)
APP_PORT=3001

# Opcional — integraciones
ANTHROPIC_API_KEY=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=IT
JIRA_ISSUE_TYPE=Task
