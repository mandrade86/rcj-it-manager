# Copia a `.env` para desarrollo local con `npm run dev`.
# Docker: ver .env.development.example y .env.production.example — DOCKER.md

# Login (obligatorio en Docker / producción)
JWT_SECRET=
INIT_DATA_ON_START=false

# Active Directory — login unificado (API EHR corporativa = credenciales de dominio)
AUTH_AD_ENABLED=true
EHR_LOGIN_URL=https://ehr.rcjcorp.hn:8095/api/Login
AD_EMAIL_DOMAINS=rcjcorp.com,grupoc.com
AUTH_LOCAL_FALLBACK=true
# AUTH_LOCAL_FALLBACK=false   # solo AD (sin contraseña local)

# Análisis OPEX con IA (módulo Gastos → Analizar con IA)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Jira — Tech Debt (Arquitectura IT → crear issues desde deuda técnica)
# URL base sin barra final, ej: https://rcj.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=marcela.hernandez@rcjcorp.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=IT
JIRA_ISSUE_TYPE=Task
