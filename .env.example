# Copia a `.env` para desarrollo local con `npm run dev`.
# Docker: ver .env.development.example y .env.production.example — DOCKER.md

# Login (obligatorio en Docker / producción)
JWT_SECRET=
INIT_DATA_ON_START=false

# Avisos por Teams: URL del flujo de Power Automate / Workflows de Teams
# ("When a Teams webhook request is received"). Trátala como secreto.
TEAMS_WEBHOOK_URL=

# PMO Personal (bot Teams + digests) — ver deploy/PMO-TEAMS.md
# PMO_BOT_APP_ID=
# PMO_BOT_APP_PASSWORD=
# PMO_BOT_TENANT_ID=
# PMO_BOT_APP_TYPE=MultiTenant
# PMO_DIGEST_KEY=
# PMO_DIGEST_CRON=false
# PMO_DIGEST_INTERVAL_HOURS=24


# Login IT Manager (correo + contraseña bcrypt en MongoDB)
# AUTH_AD_ENABLED=true solo si quieres validar contra Active Directory vía EHR
AUTH_AD_ENABLED=false
# Usuario demo solo-BI-Costeo (bi.costeo@rcjcorp.com / Costeo2026!) — false para no crearlo
BI_COSTEO_DEMO_USER=true
# Con AD activo: true permite respaldo con contraseña local de emergencia
AUTH_LOCAL_FALLBACK=false
# Solo si AUTH_AD_ENABLED=true (dominio Windows)
AD_DOMAIN=RCJ
AD_EMAIL_DOMAINS=rcjcorp.com,grupoc.com

# EHR — sincronización de empleados (no es el login del portal)
EHR_LOGIN_URL=https://ehrapi.rcjcorp.hn/api/Login

# Correo con SendGrid (reseteo de clave y códigos de acceso)
# SENDGRID_API_KEY=SG.xxxxxxxx
# SENDGRID_FROM="RCJ IT Manager <noreply@rcjcorp.com>"
# APP_PUBLIC_URL=http://127.0.0.1:5173

# Análisis OPEX con IA (módulo Gastos → Analizar con IA)
# IA opcional — gemini u ollama (OpenAI desactivado)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=

# Jira — Tech Debt (Arquitectura IT → crear issues desde deuda técnica)
# URL base sin barra final, ej: https://rcj.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=marcela.hernandez@rcjcorp.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=IT
JIRA_ISSUE_TYPE=Task

# eTicket → servicios de desarrollo (ver deploy/ETICKET-SERVICIOS.md)
# ETICKET_API_BASE_URL=https://eticket.rcjcorp.hn
# ETICKET_API_KEY=
# ETICKET_SYNC_CRON=false
# ETICKET_SYNC_INTERVAL_MINUTES=15
